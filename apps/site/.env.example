# The web app's and API's settings on Vercel (or in .env.local for `pnpm dev`).
# Postgres (use the pooled connection string; DATABASE_URL_UNPOOLED, if set, runs migrations).
DATABASE_URL=postgres://user:password@host/branchr
# Where this is reached; the Discord redirect is $PUBLIC_URL/auth/discord/callback.
PUBLIC_URL=http://localhost:5180
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The hub the web app opens unless told otherwise (may be empty).
DEFAULT_HUB=
