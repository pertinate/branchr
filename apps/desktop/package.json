{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hostable Discord-style chat with uncapped game streaming",
  "author": "Pertinate",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "package": "pnpm build && electron-builder --linux dir",
    "dist": "pnpm build && electron-builder --linux --publish never",
    "build": "pnpm --filter web build && node scripts/build-main.mjs",
    "dist:win": "pnpm build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/Pertinate/discord-clone",
  "desktopName": "discord-clone.desktop",
  "optionalDependencies": {
    "@vencord/venmic": "^7.2.3"
  }
}
