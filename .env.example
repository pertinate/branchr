# Hostname or IP clients use to reach this server.
PUBLIC_HOST=chat.example.com
# Public IPv4 address for media (UDP). Usually the server's public IP.
PUBLIC_IP=203.0.113.10
# Long random string shared by api and sfu: `openssl rand -hex 32`
VOICE_SECRET=change-me
# Set to false to stop new signups after your community has joined.
OPEN_REGISTRATION=true
# Workers = CPU cores you want for media; open UDP 50000..(50000+workers-1).
SFU_WORKERS=4
