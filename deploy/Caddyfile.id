# branchr ID on its own hostname (mounted by deploy/docker-compose.id.yml).
{$ID_DOMAIN} {
	encode zstd gzip
	# DM call signaling (the id-sfu container, when the "calls" profile is on).
	handle_path /sfu/* {
		reverse_proxy id-sfu:8090
	}
	# Hubs reached through the relay, at /h/<name>/ (the "relay" profile).
	handle /h/* {
		reverse_proxy relay:8800
	}
	# The product site and web app are on Vercel; everything else is branchr ID. The app's
	# config.js is branchr ID's too, since it names the default hub (DEFAULT_HUB).
	handle /app/config.js {
		reverse_proxy id:8070
	}
	@web path / /app /app/* /assets/* /icon.svg /features /performance /how-it-works /self-host
	handle @web {
		redir /app /app/ 308
		reverse_proxy https://{$WEB_HOST} {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		reverse_proxy id:8070
	}
}
